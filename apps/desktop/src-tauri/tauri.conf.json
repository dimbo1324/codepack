{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codepack",
  "mainBinaryName": "codepack-desktop",
  "version": "2.0.0",
  "identifier": "dev.codepack.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @codepack/ui dev",
    "beforeBuildCommand": "pnpm --filter @codepack/ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "codepack",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"]
      }
    }
  }
}
