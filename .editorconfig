root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# `.svelte`, `.mjs`, and `.cjs` were missing here until 2026-07-26. Nothing enforced this
# file before, so those sources were hand-written with two spaces and drifted from the
# four-space `[*]` default without anyone noticing. Prettier reads `.editorconfig` as a
# fallback for options it is not given, so leaving them out would have had it reindent
# every Svelte component on its first run.
[*.{js,mjs,cjs,ts,tsx,svelte,json,jsonc,yml,yaml,html,css,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
