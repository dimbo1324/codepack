# Normalize text files to LF so CI sees the same line endings on Windows and Linux.
* text=auto eol=lf

# Windows shell entrypoints must keep CRLF line endings for cmd.exe compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The root-level installer duplicate (audit 2026-09-07, D-1): a binary, not text — git
# must not try to diff or normalize line endings inside it.
setup.exe binary
